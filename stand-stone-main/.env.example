# ---------------------------------------------------------------------------
# Frontend environment variables (Vite). Copy this file to `.env` and edit.
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# OPTIONAL. Base URL of the order API (see the `server/` folder).
# Leave empty/undefined and the site stays fully functional: the order form then
# sends the request through WhatsApp instead of saving it to a database.
#
# Local backend:   VITE_API_URL=http://localhost:5000
# Production:      VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=
