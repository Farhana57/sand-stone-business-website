# ---------------------------------------------------------------------------
# Backend (order API). Copy to `server/.env` and edit. Never commit real values.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Local:    mongodb://127.0.0.1:27017/sand_stone
# Atlas:    mongodb+srv://<user>:<password>@<cluster>/sand_stone
MONGODB_URI=mongodb://127.0.0.1:27017/sand_stone

PORT=5000

# Comma-separated list of browser origins allowed to POST orders.
CORS_ORIGINS=http://localhost:3000

# OPTIONAL. Enables the read-only "list orders" endpoint, which is meant for a
# staff dashboard. Leave unset to keep the endpoint disabled entirely.
# Send it as the `x-admin-token` header.
# ADMIN_TOKEN=change-me-to-a-long-random-string
